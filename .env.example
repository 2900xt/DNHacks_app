# Copy to .env and fill in. Never commit .env.
# Every new key MUST be added here too, or teammates' builds break silently.

# --- service ---
API_HOST=0.0.0.0
API_PORT=8000

# --- web ---
# Point the UI at the API. Change to the LAN IP when demoing off a laptop.
PUBLIC_API_URL=http://localhost:8000

# --- device / m5stack node ---
DEVICE_SERIAL_PORT=/dev/ttyUSB0
DEVICE_BAUD=115200

# --- ml ---
MODEL_PATH=./ml/artifacts/model.onnx

# --- third party (add real keys locally only) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MAPBOX_TOKEN=

# --- depot node (storage-condition monitoring) ---
# Demo mode shortens the dwell so a judge's thumb on the sensor trips an
# excursion in ~10s instead of the 30 min a real HVAC failure would take.
# Set to 0 for honest timings.
DEPOT_DWELL_S=8
# Retention for the MKT window, and the minimum span before the service will
# latch an MKT breach. A mean kinetic temperature over four minutes is not a
# storage determination, so below MIN_WINDOW_S it is reported as provisional.
DEPOT_WINDOW_S=86400
DEPOT_MIN_WINDOW_S=3600
# Honour device-supplied timestamps. Required for `make depot-demo` (replay plays
# 24h of history in ~3s). Leave OFF for real devices — their clocks drift.
DEPOT_TRUST_DEVICE_TS=1
