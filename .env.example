# Copy to .env and fill in. Never commit .env.
# Every new key MUST be added here too, or teammates' builds break silently.

# --- service ---
API_HOST=0.0.0.0
API_PORT=8000

# --- web ---
# Point the UI at the API. Change to the LAN IP when demoing off a laptop.
PUBLIC_API_URL=http://localhost:8000

# --- device / firmware ---
DEVICE_SERIAL_PORT=/dev/ttyUSB0
DEVICE_BAUD=115200

# --- ml ---
MODEL_PATH=./ml/artifacts/model.onnx

# --- third party (add real keys locally only) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MAPBOX_TOKEN=
