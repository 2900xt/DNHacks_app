{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnhacks26/schemas/detection.schema.json",
  "title": "Detection",
  "description": "One model output the operator UI renders. PLACEHOLDER - replace once the idea is locked.",
  "type": "object",
  "required": ["id", "ts", "kind", "confidence"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "description": "UUID. Generated by the service, not the model." },
    "ts": { "type": "string", "format": "date-time" },
    "source_device_id": { "type": ["string", "null"] },
    "kind": {
      "type": "string",
      "description": "Detection class. Keep this a closed set - the UI needs a colour and an icon per value.",
      "minLength": 1
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "location": {
      "type": ["object", "null"],
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"],
      "description": "Drives UI colour. The demo needs at least one of these to be visibly alarming."
    },
    "explanation": {
      "type": ["string", "null"],
      "description": "Human-readable why. This is what you read aloud during the demo - do not skip it."
    },
    "evidence": {
      "type": "array",
      "description": "Links to supporting artifacts (image, audio clip, raw window).",
      "items": {
        "type": "object",
        "required": ["type", "uri"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["image", "audio", "video", "series", "text"] },
          "uri": { "type": "string" },
          "caption": { "type": ["string", "null"] }
        }
      }
    }
  }
}
