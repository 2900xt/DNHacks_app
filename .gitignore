ml/cache/

# --- Layer 1c signal cache (ml/signals/) ---
# Pin the small artifacts so the demo survives venue wifi; the bulk downloads
# are re-fetched by the loaders. See docs in each loader module.
data/cache/**/*.zip
data/cache/_ca/
data/cache/federal-register/text-*.txt
!data/cache/federal-register/text-2026-11571.txt
!data/cache/fda-inspections/*.csv

# --- AEGIS pathfinder (ml/aegis.py) ---
# Bulk registers it re-fetches on demand; too large to commit.
data/cache/dmf/*.xlsx
data/cache/decrs/*.zip

# --- next-failure model (ml/risk/) ---
# Source registers and the derived tables; all re-fetched by the loaders.
# `make risk` rebuilds web/data/risk.json from them in about a minute.
data/cache/risk/
